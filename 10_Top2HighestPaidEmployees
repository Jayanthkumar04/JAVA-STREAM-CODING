public class Main {
    public static void main(String[] args) {

        List<Employee> employees = Arrays.asList(
                new Employee("Rahul", 25, 45000),
                new Employee("Priya", 28, 52000),
                new Employee("Arjun", 30, 65000),
                new Employee("Sneha", 26, 48000),
                new Employee("Vikram", 32, 75000)
        );


        List<Employee> emps = employees.stream()
                 .sorted(Comparator.comparingDouble(emp->-1*emp.getSalary()))
                 .limit(2)
                 .collect(Collectors.toList());

                 sysout(emps);
    }
}
