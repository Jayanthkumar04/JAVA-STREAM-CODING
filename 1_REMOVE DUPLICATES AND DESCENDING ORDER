import java.util.*;
class Main {
    public static void main(String[] args) {

             List<Integer> list = new ArrayList<>(Arrays.asList(5,3,1,3,2,5,4));

             List<Integer> ansList = list.stream()
                                         .distinct()
                                         .sorted(Comparator.reverseOrder())
                                         .toList();

             System.out.println(ansList);
        
    }
}
