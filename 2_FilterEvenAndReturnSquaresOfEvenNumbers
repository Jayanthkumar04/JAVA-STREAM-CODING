import java.util.*;
import java.util.stream.*;
class Main {
    public static void main(String[] args) {

             List<Integer> list = new ArrayList<>(Arrays.asList(1,5,8,2,9,4));

             List<Integer> ans = list.stream()
                                     .filter(x->x%2==0)
                                     .map(x->x*x)
                                     .collect(Collectors.toList());

            System.out.println(ans);
        
    }
}
